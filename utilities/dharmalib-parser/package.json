{
	"name": "dharmalib-parser",
	"version": "0.1.0",
	"description": "Types, validation and a display model for Dharmalib Sanskrit text JSON files.",
	"type": "module",
	"private": true,
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"test": "node --test test.ts",
		"test:full": "DHARMALIB_MAX_BYTES=99999999 node --max-old-space-size=8192 --test test.ts",
		"typecheck": "tsc --noEmit"
	},
	"engines": {
		"node": ">=22"
	}
}
